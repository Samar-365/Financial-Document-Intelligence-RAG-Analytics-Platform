# ==============================================================================
# Financial Document Intelligence & RAG Analytics Platform - Environment Config
# Copy this file to .env and configure local secret credentials.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# API Server Configuration (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration (Streamlit)
STREAMLIT_SERVER_PORT=8501
BACKEND_API_BASE_URL=http://localhost:8000

# PostgreSQL Relational Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=financial_rag_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_rag_db

# Large Language Model & RAG Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FALLBACK_MODEL=llama3:8b

# Embedding & Vector Storage Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
FAISS_INDEX_PATH=data/faiss_index

# Document Processing & Storage
UPLOAD_DIRECTORY=data/uploads
MAX_FILE_SIZE_MB=50
