# ==============================================================================
# Financial Document Intelligence & RAG Analytics Platform - Environment Config
# Copy this file to .env and configure local secret credentials.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# API Server Configuration (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Frontend Configuration (Streamlit)
STREAMLIT_SERVER_PORT=8501
BACKEND_API_BASE_URL=http://localhost:8000/api/v1
API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL Relational Database (Docker Alpine pgvector container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=financial_intelligence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_intelligence

# Security & Rate Limiting
JWT_SECRET=change-this-to-a-secure-random-32-byte-secret
RATE_LIMIT_PER_MINUTE=100
MAX_UPLOAD_SIZE_MB=50

# AI Intelligence (Google Gemini API & Local Air-Gapped Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FALLBACK_MODEL=llama3:8b

# Embedding & Vector Storage Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
FAISS_INDEX_PATH=data/faiss_index

# Document Processing & Storage
UPLOAD_DIRECTORY=data/uploads
